# Copy to .env and fill in the values: cp .env.example .env
# Every variable the app reads is listed here; commented ones show their default.

# ─── Required ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ferum_board_db
APP_URL=http://localhost:5173
# Min 32 chars. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-min-32-chars-random-hex
JWT_EXPIRY_SECONDS=3600
REFRESH_TOKEN_EXPIRY_DAYS=7
# Sender address on every outgoing message, for whichever provider is active.
#
# There is no separate "from name" variable: put the display name in here, in the
# RFC 5322 form, and both providers use it —
#   FROM_EMAIL=Ferum Board <noreply@example.com>
#
# Validated at startup, and a malformed value ABORTS the boot rather than being
# discovered per-message. It used to be parsed only at send time, so a typo gave a
# process that started cleanly, reported healthy, and failed every mail with a
# generic internal error — with a background job's single log line as the only
# evidence.
FROM_EMAIL=noreply@localhost

# ─── HTTP server ─────────────────────────────────────────────────────────────
# BIND_ADDR=0.0.0.0
# PORT=5173
# Number of trusted reverse proxies in front of the app. 0 = ignore
# X-Forwarded-For (dev). Set to 1 behind a single Nginx/Cloudflare proxy,
# otherwise per-IP rate limiting keys on the proxy's IP instead of the client's.
# TRUSTED_PROXY_COUNT=0
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_ENABLED=false
MAX_UPLOAD_SIZE_MB=5

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
# Pool sizing applies per pool (write, and read replica if enabled).
# Sized for connections-per-REQUEST, not requests: handlers run COUNT and data
# fetch concurrently, so one search can hold 4-6 connections at once.
# DB_MAX_CONNECTIONS=40
# DB_MIN_CONNECTIONS=2
# Every connection carries statement_timeout=30s and
# idle_in_transaction_session_timeout=60s, appended automatically. Set your own
# `options=` in DATABASE_URL to override; migrations and plugin SQL are handled
# separately (see CLAUDE.md).
# DATABASE_READ_URL=postgresql://forum:forum@localhost:5433/forum_dev

# ─── SMTP (MailHog for dev: brew install mailhog) ────────────────────────────
# Uncomment to require email verification (needs MailHog or real SMTP running).
# These values are seeded into the site_config table on first startup; after
# that, update them via admin/settings → Email tab, which applies them to the
# live transport immediately — no restart.
#
# TLS is inferred from the address, with no setting to get wrong: a loopback host
# connects in the clear (MailHog presents no certificate), port 465 uses implicit
# TLS, and every other host requires STARTTLS. A relay that does not offer it is
# refused rather than handed these credentials in plaintext. One consequence for
# a Compose-based dev setup: `SMTP_HOST=mailhog` is not loopback, so it would need
# TLS — keep `localhost` and publish the port instead.
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=

# ─── Optional: Resend (transactional email over HTTPS) ───────────────────────
# Presence of this key is the toggle, and it WINS over the SMTP block above and
# over anything stored in site_config. Deliberately env-only: a key that can send
# mail as your domain does not belong in a table the admin settings page renders.
# Rotating it therefore needs a restart.
# Verify your sending domain in Resend first, and make FROM_EMAIL an address on
# it — an unverified domain is the most common cause of a rejected send.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# ─── Optional: Secrets at rest ───────────────────────────────────────────────
# Encrypts the two secrets this app stores in PostgreSQL — the SMTP password in
# `site_config`, and each webhook's HMAC key. 64 hex characters (32 bytes).
#
# What it protects: someone who reads the database WITHOUT reading this
# environment — a dump, a backup on third-party storage, a leaked replica. It does
# not protect against an attacker already on the host, where the key is readable.
#
# Enabling it needs no migration: existing plaintext rows are read unchanged and
# converted on the next start. LOSING THE KEY makes those two values
# unrecoverable — nothing else in the database is encrypted, so posts, users and
# threads are never at risk. Rotation and recovery: docs/deployment.md.
# SECRET_ENCRYPTION_KEY=$(openssl rand -hex 32)
#
# Only during a rotation: the key being retired. Values are opened with the
# current key first, then this one, and everything is re-sealed on start. Unset it
# once the log reports the re-seal count.
# SECRET_ENCRYPTION_KEY_PREVIOUS=

# ─── Optional: Redis (async jobs + rate limit) ───────────────────────────────
# REDIS_URL=redis://localhost:6379

# ─── Optional: S3 / MinIO (file uploads; fallback is DB storage) ─────────────
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=forum-uploads
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_REGION=us-east-1        # only matters for real AWS S3; MinIO/R2 ignore it
#
# S3_ENDPOINT can also be pointed at Google Cloud Storage's S3 interoperability
# endpoint (https://storage.googleapis.com) with an HMAC key pair as
# S3_ACCESS_KEY / S3_SECRET_KEY. That works, but the keys are long-lived static
# secrets — GCS_BUCKET below gets you keyless Workload Identity instead.

# ─── Optional: Google Cloud Storage (needs `cargo build --features gcs`) ─────
# THE BUCKET MUST BE READABLE BY allUsers, or every image renders broken with
# nothing failing on the server:
#   gcloud storage buckets add-iam-policy-binding gs://YOUR_BUCKET \
#       --member=allUsers --role=roles/storage.legacyObjectReader
# Use legacyObjectReader, NOT objectViewer: objectViewer also grants
# storage.objects.list, letting anyone on the internet enumerate every object in
# the bucket. legacyObjectReader grants only storage.objects.get — readable if
# you know the name, not discoverable.
# With uniform bucket-level access on (the default for new buckets) that IAM
# binding is the only mechanism — per-object ACLs are ignored. The app checks
# this on startup and WARNs if an anonymous read is refused.
#
# Presence of GCS_BUCKET is the toggle, and it WINS over S3_ENDPOINT if both
# are set. Leave all three credential lines commented out when running on
# GCE / GKE / Cloud Run: the metadata server then supplies the token and no
# secret exists anywhere in the deployment (Workload Identity). Locally,
# `gcloud auth application-default login` is picked up automatically.
# GCS_BUCKET=forum-uploads
# GCS_PREFIX=ferum            # optional; only for a bucket shared with other apps
#   CAREFUL: the allUsers binding above is BUCKET-WIDE, so sharing a bucket
#   publishes the other workload's objects too. To share safely, create a
#   managed folder named after this prefix and bind the role on the FOLDER, not
#   the bucket (needs uniform bucket-level access). Otherwise use a dedicated
#   bucket and leave GCS_PREFIX unset.
# GCS_CREDENTIALS_FILE=/etc/ferum/gcs-sa.json
# GOOGLE_APPLICATION_CREDENTIALS=/etc/ferum/gcs-sa.json   # standard ADC variable
# GCS_CREDENTIALS_JSON={"type":"service_account", ...}    # last resort: a private key in the environment

# ─── Optional: CDN ──────────────────────────────────────────────────────────
# CDN_BASE_URL=https://cdn.yourdomain.com

# ─── Optional: Meilisearch (fallback is PostgreSQL FTS) ─────────────────────
# MEILISEARCH_URL=http://localhost:7700
# MEILISEARCH_KEY=
# MEILISEARCH_INDEX=threads  # override when several envs share one instance
# MEILISEARCH_PRODUCT_INDEX=products  # catalogue index; searched alongside threads

# ─── Optional: Headless first-run setup ──────────────────────────────────────
# Set all three to auto-create the first admin on startup (skips /setup wizard)
# SETUP_ADMIN_USERNAME=admin
# SETUP_ADMIN_EMAIL=admin@yourdomain.com
# SETUP_ADMIN_PASSWORD=

# ─── Template & static paths (relative to where `cargo run` is executed) ────
THEMES_DIR=../frontend/themes
ADMIN_TEMPLATES_DIR=../frontend/templates
STATIC_DIR=../frontend/static
PLUGINS_DIR=../plugins

# ─── Plugin runtime ──────────────────────────────────────────────────────────
# PLUGIN_HOOK_TIMEOUT_MS=500     # kill a before_* hook running longer than this
# PLUGIN_CIRCUIT_THRESHOLD=10    # consecutive failures before circuit opens

# ─── App behaviour ──────────────────────────────────────────────────────────
# Dedup view counts via cache (set_nx 24h/user/thread). Only affects logged-in
# users; guests are not counted when enabled. Best with REDIS_URL configured.
DEDUP_VIEW_COUNTS=true

# ─── Logging ────────────────────────────────────────────────────────────────
# ferum_web is the LIBRARY crate (all handlers, middleware, render logic) — its tracing
# target is `ferum_web::*`, separate from the binary entry-point `ferum_board`.
# Both must appear here or web-layer errors/warns will be silently dropped.
#
# RUST_LOG and LOG_LEVEL are the SAME filter with two sources, and RUST_LOG wins
# outright: main.rs tries `EnvFilter::try_from_default_env()` first and only falls
# back to LOG_LEVEL when RUST_LOG is absent. Setting both and editing LOG_LEVEL is
# therefore a change with no effect — the usual reason a log-level tweak "does
# nothing". Comment RUST_LOG out if you want LOG_LEVEL to be the live knob.
RUST_LOG=ferum_board=info,ferum_web=info,ferum_application=info,ferum_domain=info,ferum_infrastructure=info,tower_http=info
# LOG_LEVEL=ferum_web=info,ferum_application=info,ferum_domain=info,ferum_infrastructure=info,tower_http=info
LOG_FORMAT=pretty
SLOW_QUERY_MS=500
# Directory for rotating log files; unset = stdout only
# LOG_DIR=../logs

# Translation catalogs (one subdirectory per locale)
LOCALES_DIR=../locales
