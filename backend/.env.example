# Copy to .env and fill in the values: cp .env.example .env
# Every variable the app reads is listed here; commented ones show their default.

# ─── Required ────────────────────────────────────────────────────────────────
# You create the database; migrations run in-process at startup and create the
# schema. A database predating the migration squash cannot migrate forward —
# drop and recreate it.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ferum_board_db
# This site's public origin, scheme included, no trailing slash. Also the first
# CSRF allowlist entry — setting it non-local DROPS localhost from that list.
APP_URL=http://localhost:5173
# Min 32 chars. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-min-32-chars-random-hex
# Access-token lifetime. Sets the JWT `exp` claim AND the auth cookie's Max-Age,
# so the two can never disagree. Default 3600 (1h).
JWT_EXPIRY_SECONDS=3600
# Refresh-token lifetime, i.e. how long a user stays signed in without
# re-entering a password. Default 7.
REFRESH_TOKEN_EXPIRY_DAYS=7
# Sender on every outgoing message. Put any display name in here, RFC 5322 form
# (`Ferum Board <noreply@example.com>`); there is no separate from-name var.
# Malformed values ABORT startup. See docs/configuration.md.
FROM_EMAIL=noreply@localhost

# ─── HTTP server ─────────────────────────────────────────────────────────────
# Interface to listen on. Default 0.0.0.0 (every interface). Use 127.0.0.1 when
# a reverse proxy on the same host is the only thing that should reach the app.
# BIND_ADDR=0.0.0.0
# Default 5173. Inside a container leave it alone and remap on the host side —
# the healthcheck in deploy/docker-compose.prod.yml has this port baked in.
# PORT=5173
# Number of trusted reverse proxies in front of the app. 0 = ignore
# X-Forwarded-For (dev). Set to 1 behind a single Nginx/Cloudflare proxy,
# otherwise per-IP rate limiting keys on the proxy's IP instead of the client's.
# TRUSTED_PROXY_COUNT=0
# Comma-separated extra origins beyond APP_URL. Not just CORS — the same list
# is the CSRF allowlist, so an unlisted Origin gets 403 on any write.
CORS_ORIGINS=http://localhost:5173
# CODE DEFAULT IS `true`; this file ships the dev profile. Left false in
# production it disables auth brute-force and public-write limits entirely.
RATE_LIMIT_ENABLED=false
# Per-upload ceiling, MB. The request body limit is max(this, 50MB) + 1MB — a
# plugin package may be 50 MB — so lowering this below 50 changes nothing.
# Behind a proxy nginx's client_max_body_size is the real outer ceiling.
MAX_UPLOAD_SIZE_MB=5

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
# Pool sizing applies per pool (write, and read replica if enabled).
# Sized for connections-per-REQUEST, not requests: handlers run COUNT and data
# fetch concurrently, so one search can hold 4-6 connections at once.
# DB_MAX_CONNECTIONS=40
# DB_MIN_CONNECTIONS=2
# Every connection carries statement_timeout=30s and
# idle_in_transaction_session_timeout=60s, appended automatically. Set your own
# `options=` in DATABASE_URL to override; migrations and plugin SQL are handled
# separately (see CLAUDE.md).
# DATABASE_READ_URL=postgresql://forum:forum@localhost:5433/forum_dev

# ─── SMTP (MailHog for dev: brew install mailhog) ────────────────────────────
# Seeded into site_config on first startup; after that edit at admin/settings →
# Email, which swaps the live transport with no restart. TLS is inferred from
# the address, so keep `localhost` for MailHog — a non-loopback host demands it.
# Details: docs/configuration.md.
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=

# ─── Optional: Resend (transactional email over HTTPS) ───────────────────────
# Presence is the toggle; WINS over SMTP and over site_config. Env-only, so
# rotating needs a restart. Verify your sending domain in Resend first — an
# unverified one is the commonest cause of a rejected send.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# ─── Optional: Secrets at rest ───────────────────────────────────────────────
# 64 hex chars. Encrypts the SMTP password and webhook HMAC keys in PostgreSQL,
# guarding a stolen dump — not an attacker on the host. LOSING IT makes those
# two values unrecoverable; nothing else is encrypted. docs/configuration.md.
# SECRET_ENCRYPTION_KEY=$(openssl rand -hex 32)
# During a rotation only: the key being retired. Unset once the log reports the
# re-seal count.
# SECRET_ENCRYPTION_KEY_PREVIOUS=

# ─── Optional: Redis (async jobs + rate limit) ───────────────────────────────
# Presence is the toggle; absent = in-process cache and rate limiting, which is
# correct for ONE INSTANCE ONLY: two instances each keep their own counters, so
# the effective rate limit doubles.
# REDIS_URL=redis://localhost:6379

# ─── Optional: S3 / MinIO (needs `cargo build --features s3`) ────────────────
# Presence of S3_ENDPOINT is the toggle; fallback is database storage. WITHOUT
# THE FEATURE FLAG these variables are ignored — the app logs a WARN naming the
# missing feature and every upload lands in PostgreSQL instead.
# Loses to both GCS_BUCKET and R2_ACCOUNT_ID. Path-style addressing, so the
# public URL is {endpoint}/{bucket}/{key} unless CDN_BASE_URL overrides it.
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=forum-uploads
# MinIO's published defaults — change for anything real.
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_REGION=us-east-1        # only matters for real AWS S3; MinIO/R2 ignore it

# ─── Optional: Google Cloud Storage (needs `cargo build --features gcs`) ─────
# Presence of GCS_BUCKET is the toggle; WINS over S3_ENDPOINT, loses to R2.
# THE BUCKET MUST BE allUsers-READABLE via roles/storage.legacyObjectReader, or
# every image renders broken with nothing failing server-side. Not objectViewer
# — it also grants list. Exact command + why: docs/configuration.md.
# GCS_BUCKET=forum-uploads
# Optional. CAREFUL: the allUsers binding is BUCKET-WIDE, so a prefix does not
# make a shared bucket safe — see docs/configuration.md for managed folders.
# GCS_PREFIX=ferum
# Leave all three unset on GCE/GKE/Cloud Run — the metadata server supplies the
# token and no secret exists in the deployment (Workload Identity).
# GCS_CREDENTIALS_FILE=/etc/ferum/gcs-sa.json
# GOOGLE_APPLICATION_CREDENTIALS=/etc/ferum/gcs-sa.json   # standard ADC variable
# GCS_CREDENTIALS_JSON={"type":"service_account", ...}    # last resort: a private key in the environment

# ─── Optional: Cloudflare R2 (needs `cargo build --features r2`) ─────────────
# Presence of R2_ACCOUNT_ID is the toggle; WINS over GCS_BUCKET and S3_ENDPOINT.
# Credentials are an R2 API token's Access Key ID / Secret Access Key.
# R2_ACCOUNT_ID=
# R2_BUCKET=forum-uploads
# R2_ACCESS_KEY=
# R2_SECRET_KEY=
# MANDATORY — STARTUP FAILS WITHOUT IT. R2's S3 endpoint serves signed requests
# only, so no public origin can be derived, and a minted URL is written into
# post HTML that is never rewritten. Use a custom domain or the bucket's r2.dev
# URL; CDN_BASE_URL is not a substitute. Why: docs/configuration.md.
# R2_PUBLIC_BASE_URL=https://cdn.yourdomain.com
# R2_ENDPOINT=            # optional; only for a jurisdiction-restricted endpoint

# ─── Optional: CDN ──────────────────────────────────────────────────────────
# Origin for uploaded files: {cdn}/files/{key} on database storage, {cdn}/{key}
# on S3 and GCS. No trailing slash. Unset is fine — each backend then uses its
# own origin. UNSETTING IT LATER orphans URLs written while it was set, since
# the absolute form is only recognised back in while this is present.
# CDN_BASE_URL=https://cdn.yourdomain.com

# ─── Optional: Meilisearch (needs `cargo build --features meilisearch`) ─────
# Presence of MEILISEARCH_URL is the toggle; fallback is PostgreSQL FTS, which
# is sufficient below roughly 100k threads. Without the feature flag the
# variable is ignored and a WARN says so.
# MEILISEARCH_URL=http://localhost:7700
# The instance's master key, or an API key with search + document write. An
# instance started without a master key needs nothing here.
# MEILISEARCH_KEY=
# MEILISEARCH_INDEX=threads  # override when several envs share one instance
# MEILISEARCH_PRODUCT_INDEX=products  # catalogue index; searched alongside threads

# ─── Optional: Headless first-run setup ──────────────────────────────────────
# Set all three to auto-create the first admin on startup (skips /setup wizard)
# SETUP_ADMIN_USERNAME=admin
# SETUP_ADMIN_EMAIL=admin@yourdomain.com
# SETUP_ADMIN_PASSWORD=

# ─── Template & static paths (relative to where `cargo run` is executed) ────
# Relative to the process cwd, assumed to be `backend/`. QUIET failure: a wrong
# path renders a blank page rather than raising. Set absolutely in the image.
THEMES_DIR=../frontend/themes
ADMIN_TEMPLATES_DIR=../frontend/templates
STATIC_DIR=../frontend/static
PLUGINS_DIR=../plugins
# Translation catalogs, one subdirectory per locale. Unlike the four above this
# fails LOUDLY: falls back to ./locales or ../locales with a WARN, and ABORTS
# startup if none exists or the catalog yields zero messages.
LOCALES_DIR=../locales

# ─── Plugin runtime ──────────────────────────────────────────────────────────
# PLUGIN_HOOK_TIMEOUT_MS=500     # kill a before_* hook running longer than this
# PLUGIN_CIRCUIT_THRESHOLD=10    # consecutive failures before circuit opens

# ─── App behaviour ──────────────────────────────────────────────────────────
# Dedup view counts via cache (set_nx 24h/user/thread). Only affects logged-in
# users; guests are not counted when enabled. Best with REDIS_URL configured.
DEDUP_VIEW_COUNTS=true

# ─── Logging ────────────────────────────────────────────────────────────────
# RUST_LOG and LOG_LEVEL are the SAME filter, and RUST_LOG WINS — setting both
# then editing LOG_LEVEL does nothing. Comment RUST_LOG out to use LOG_LEVEL.
# Both `ferum_board` (binary) and `ferum_web` (library) must be listed or
# web-layer errors are silently dropped. docs/configuration.md.
RUST_LOG=ferum_board=info,ferum_web=info,ferum_application=info,ferum_domain=info,ferum_infrastructure=info,tower_http=info
# LOG_LEVEL=ferum_web=info,ferum_application=info,ferum_domain=info,ferum_infrastructure=info,tower_http=info
# `pretty` (human-readable, for a terminal) or `json` (one object per line, for
# a log aggregator). Any other value falls back to `pretty`.
LOG_FORMAT=pretty
# Emit a WARN for any repository query slower than this many ms. Default 500.
# This only reports; it never cancels a query — the server-side
# statement_timeout=30s above is what actually stops one.
SLOW_QUERY_MS=500
# Directory for rotating log files; unset = stdout only
# LOG_DIR=../logs
