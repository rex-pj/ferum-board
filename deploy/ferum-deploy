#!/bin/bash
#
# Roll the `app` container onto a new image tag and wait for it to answer.
#
# The ONLY command the CI account may run through sudo. Allowlisting `docker
# compose` instead is equivalent to granting root — it will happily start a
# container that bind-mounts / — so everything choosable is fixed here and only
# the image tag comes from the caller, validated below.
#
# THIS SCRIPT AND /opt/ferum MUST BE ROOT-OWNED and unwritable by the deploy
# account: if it can edit docker-compose.prod.yml it can declare its own mounts.
set -euo pipefail

TAG="${1:?usage: ferum-deploy <40-hex-commit-sha>}"

# A git SHA, not "whatever CI passed". sudoers matches the command name and its
# literal arguments, so a wildcard argument is unavoidable there; this is where
# the argument actually gets constrained. Refusing anything else keeps the tag
# from being turned into a different registry path, a `latest`, or an option.
if [[ ! "$TAG" =~ ^[0-9a-f]{40}$ ]]; then
    echo "ferum-deploy: refusing image tag '$TAG' — expected a 40-character commit SHA" >&2
    exit 2
fi

cd /opt/ferum

# --env-file is not optional: env_file: supplies variables INSIDE a container,
# while the ${...} substitutions in the compose file are resolved by Compose
# itself, which reads only this. Omit it and DB_PASSWORD expands to empty.
compose() {
    docker compose --env-file .env.prod -f docker-compose.prod.yml "$@"
}

export IMAGE_TAG="$TAG"
compose pull app

# NO service name — Compose starts the named service plus what it DEPENDS ON,
# and nginx depends on app, not the reverse. Naming `app` leaves port 443 with
# no listener on a fresh box while the deploy reports success.
#
# Safe on later deploys: only containers whose config or image changed are
# recreated, so a routine rollout does not restart Postgres.
compose up -d

# 30 × 5s — a generous ceiling, not a latency expectation: first boot runs
# migrations, and an index build on a mature table is legitimately slow.
#
# The probe runs INSIDE the container. `app` publishes no ports, so 5173 exists
# only on the compose network and curling it from the host reaches nothing.
#
# Probing through nginx instead would test TLS and the proxy as well, which
# sounds better and is worse here: this loop exists to decide whether the new
# image is serving, and a certificate problem is not that question.
for _ in $(seq 1 30); do
    if compose exec -T app curl -fsS http://localhost:5173/health/ready >/dev/null 2>&1; then
        echo "ferum-deploy: $TAG is ready"
        # Only prune once the new container is known good. Pruning earlier would
        # discard the previous image while it is still the thing to roll back to.
        docker image prune -f
        exit 0
    fi
    sleep 5
done

echo "ferum-deploy: $TAG did not become ready within 150s" >&2
compose logs --tail=50 app >&2
exit 1
