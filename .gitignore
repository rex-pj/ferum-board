# ─── Rust / Cargo ─────────────────────────────────────────────────────────────
target/
**/*.rs.bk
**/Cargo.lock

# ─── Node (client-widgets build only) ─────────────────────────────────────────
node_modules/
.svelte-kit/
build/
dist/
.output/
package-lock.json

# ─── Theme build artifacts (Tera themes don't need Node tooling in git) ───────
frontend/themes/*/node_modules/
frontend/themes/*/package-lock.json
frontend/themes/*/package.json
frontend/themes/*/postcss.config.js

# ─── Environment & secrets ────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ─── Runtime plugin install directory ────────────────────────────────────────
# Installed plugins are extracted to plugins/{slug}/ at runtime.
# Only examples/ (in the repo root) is committed — not the runtime plugins/ dir.
/plugins/*/

# ─── Runtime user-installed themes ───────────────────────────────────────────
# frontend/themes/default/ is committed. User-installed themes extracted by admin upload
# land in frontend/themes/{slug}/ and should NOT be committed.
/frontend/themes/*/
!/frontend/themes/default/

# ─── Uploads ──────────────────────────────────────────────────────────────────
backend/tmp/

# ─── Editor ───────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.zed/
.claude/
CLAUDE.md

# ─── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/

# ─── Per-installation deployment notes ────────────────────────────────────────
# docs/deployment.md is the general runbook and IS tracked. Your own project ID,
# VM name, domain and OS Login user belong in a sibling that is not — such as
# docs/deployment.mysite.md — so the procedure stays reusable by anyone.
docs/deployment.*.md
!docs/deployment.md

# Per-installation copies of the deploy configs. deploy/nginx.conf is the
# tracked, generic one; a `.<site>.conf` sibling carries the real server_name.
deploy/*.*.conf
